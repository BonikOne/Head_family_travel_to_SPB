        $ renpy.movie_cutscene("from_home_to_casino.webm")

    $ polojenie = "casino" 
    scene bg casino
    show screen back_arrow_to_map
    show screen sportcar
    show screen door_to_casino
    $ show_hud()


    call screen wait_for_click

    return

