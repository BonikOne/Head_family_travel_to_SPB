    if not block_ui:
        imagebutton:
            idle "pc_mainroom_idle.png"
            hover "pc_mainroom_hover.png"
            xpos 587
            ypos 417
            focus_mask True
            if pc_is_unlocked == True:
                action Jump("pc_work_table")  # Показываем меню выбора
            else:
                action Jump("password") # На экран ввода пароля

