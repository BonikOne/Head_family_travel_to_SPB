    add "big_iphone.png" xpos 750 ypos 150
    imagebutton:
        idle "phone_icon_idle.png"
        xpos 790
        ypos 860
        focus_mask True
        if not block_ui:
            hover "phone_icon_hover.png"
            action [Hide("big_iphone"), Show("phone")]
