init python:
    def add_digit(digit):
        store.input_code += digit
        renpy.play("beep.mp3")
        if len(store.input_code) == 6:
            if store.input_code == "231124":
                store.vitya_lock = "open"
                renpy.play("unlock.mp3")
                renpy.jump("yaschik_vitya")
            else:
                renpy.play("wrong.mp3")
            store.input_code = "" 

