label chingis_contact_call_menu:
    menu:
        "Можешь помочь с машиной?" if polojenie == "casino_hall" or polojenie == "casino":
            Vika "Можешь помочь с машиной?"
            chingis "Канэшна"
            Vika "Она стоит возле казино закрытая, а ключи внутри"
            chingis "Две минуты дорогая"
            $ car_is_broken = True
            play sound "sbros.mp3"
        "Пока":
            Vika "Пока"
            chingis "Пока Викэ"
            play sound "sbros.mp3"
