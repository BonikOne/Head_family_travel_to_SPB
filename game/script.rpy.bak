    if not block_ui:
        imagebutton:
            idle "home_idle.png"
            hover "home_hover.png"
            xpos 1550
            ypos 310
            focus_mask True
            at Transform(zoom=1.3)
            action Jump("hallway")  # Показываем меню выбора

