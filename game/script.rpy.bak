screen wait_for_click():
    # просто висит, пока игрок не нажмёт на что-то
    pass


screen tv_in_mainroom:
    if not block_ui:
        imagebutton:
            idle "tv_mainroom_idle.png"
            hover "tv_mainroom_hover.png"
            xpos 1048
            ypos 260
            focus_mask True
            action Show("tv_menu_mainroom")  # Показываем меню выбора

