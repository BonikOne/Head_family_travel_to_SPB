screen tv_menu_mainroom():
    tag menu  # позволяет убрать экран по Esc
    modal True
    frame:
        style "menu_frame"
        xalign 0.5
        yalign 0.5
        has vbox

        text "Что вы хотите посмотреть?" size 30

        textbutton "Посмотреть клипы BTS":
            action [Hide("tv_menu_mainroom"), Jump("watch_bts")]

        textbutton "Посмотреть 'Битву экстрасенсов'":
            action [Hide("tv_menu_mainroom"), Jump("Bitva_extasensov")]
        
        textbutton "Передумать":
            action Hide("tv_menu_mainroom")

screen bed_menu_mainroom():
    tag menu
    modal True

    frame:
        style "menu_frame"
        xalign 0.5
        yalign 0.5
        has vbox

        text "Что вы хотите делать?" size 30

        if game_time == "22:00":
            textbutton "Поспать":
                action [Hide("bed_menu_mainroom"), Jump("sleep_event")]
        else:
            textbutton "Поспать (вы ещё не устали)":
                action NullAction()
                sensitive False

        textbutton "Передумать":
            action Hide("bed_menu_mainroom")

label sleep_event:
    $ renpy.free_memory()
    $ hide_all_ui()

    scene black with fade

    centered "Вы спите...\nВам снится что-то странное..."

    pause 1.5

    $ next_day()
    $ game_hour = 8
    $ game_minute = 0
    $ update_game_time()
    $ fatigue = fatigue + 50

    jump mainroom

label watch_bts:
    $ renpy.free_memory()
    $ hide_all_ui()
    scene bts_01
    with perehod_diss
    "Вы начали смотреть клипы BTS. В комнате звучит музыка..."
    scene bts_02
    with perehod_diss
    "Вы чувствуете как вы тупеете..."
    scene bts_03
    with perehod_diss
    "Но вам уже все равно..."
    scene black
    with perehod_diss
    "Ваш интеллект снизился на 1 пункт"
    $ intellect = intellect - 1
    jump mainroom

label Bitva_extasensov:
    $ renpy.free_memory()
    $ hide_all_ui()
    scene be_01
    with perehod_diss
    "Вы начали смотреть Битву экстрасенсов."
    scene be_02
    with perehod_diss
    "Вы чувствуете как магические силы наполняют вас"
    scene be_03
    with perehod_diss
    $ be_schet = be_schet - 1
    if be_schet > 0:
        "Еще [be_schet] cерий, и вы можете кастовать порчу на понос"
        scene black
        with perehod_diss
        "Все мы знаем, что она сразу полетит на Руслана"
    elif be_schet == 0:
        "Поздравляю, теперь вы можете кастовать почту на понос"
        scene black
        with perehod_diss
        "Руслан неожиданно пропал куа-то на час"
    else:
        "Вы уже кастовали порчу на понос"
        scene black
        with perehod_diss
        "Пожалейте Руслана"
    jump mainroom

label yaschik:
    $ renpy.free_memory()
    $ hide_all_ui()
    scene yaschik
    show screen back_arrow
    $ show_hud()

    if take_money_from_box_mainroom == False:    
        show screen money_mainroom
    if take_vibro_from_box_mainroom == False:    
        show screen vibro_mainroom
    if take_rebus_from_box_mainroom == False:    
        show screen rebus_mainroom    

    call screen wait_for_click

screen money_mainroom:
    if not block_ui:
        imagebutton:
            idle "money_idle.png"
            hover "money_hover.png"
            xpos 400
            ypos 217
            focus_mask True
            at Transform(zoom=0.3)
            if default_mouse == "default":
                action Show("taking_money_screen")  # Показываем меню выбора
            else:
                action Jump("eto_ne_suda")

label eto_ne_suda:
    $ renpy.free_memory()
    $ block_ui = True
    Vika "Это точно не сюда"
    $ block_ui = False
    call screen wait_for_click

    return


screen vibro_mainroom:
    if not block_ui:
        imagebutton:
            idle "vibro_idle.png"
            hover "vibro_hover.png"
            xpos 700
            ypos 217
            focus_mask True
            at Transform(zoom=0.3)
            action Show("taking_vibro_screen")  # Показываем меню выбора

screen taking_money_screen():
    tag menu
    modal True

    frame:
        style "menu_frame"
        xalign 0.5
        yalign 0.5
        has vbox

        text "Что вы хотите делать?" size 30

        textbutton "Взять":
            action [Hide("taking_money_screen"), Jump("taking_money")]

        textbutton "Передумать":
            action Hide("taking_money_screen")

screen taking_vibro_screen():
    tag menu
    modal True

    frame:
        style "menu_frame"
        xalign 0.5
        yalign 0.5
        has vbox

        text "Что вы хотите делать?" size 30

        textbutton "Взять":
            action [Hide("taking_vibro_screen"), Jump("taking_vibro")]

        textbutton "Передумать":
            action Hide("taking_vibro_screen")

label taking_money:
    $ renpy.free_memory()
    $ block_ui = True
    Vika "Эти деньги положил сюда Витя, значит они мои. (+100р)"
    $ block_ui = False
    hide screen money_mainroom
    $ take_money_from_box_mainroom = True
    $ money = money + 100
    jump yaschik

label taking_vibro:
    $ renpy.free_memory()
    $ block_ui = True
    Vika "Этого милого пингвинчика мне подарил Витя."
    Vika "Правда он почему-то не даёт его поставить на видное место и постоянно прячет в тумбу."
    Vika "Возьму его и найду лучшее применение, чем пылиться тут."
    $ block_ui = False
    hide screen vibro_mainroom
    $ add_item_to_inventory("penguin")  # Добавляем пингвина в инвентарь
    $ take_vibro_from_box_mainroom = True
    jump yaschik



label hallway:
    $ renpy.free_memory()
    $ vitya_in_room = True
    scene bg mainhall
    play music "home_theme.mp3" fadeout 1
    $ hide_all_ui()
    show screen door_to_street
    show screen door_to_mainroom
    show screen door_to_vitya_room
    show screen door_to_toilet
    show screen door_to_kitchen
    
    $ polojenie = "home"
    $ show_hud()

    call screen wait_for_click

    return

label kitchen:
    $ renpy.free_memory()
    scene bg mainkitchen
    $ hide_all_ui()
    show screen back_arrow_to_hallway
    show screen plita
    
    
    $ show_hud()

    call screen wait_for_click

    return

screen plita:
    imagebutton:
        idle "plita.png"
        focus_mask True
        if not block_ui:
            hover "plita_hover.png"
            if "produkti" in inventory_items:
                action Jump("cook")
            else:
                action Jump("net_piduktov") 

label net_piduktov:
    $ renpy.free_memory()
    $ block_ui = True
    Vika "Мне пока не надо готовить"
    $ block_ui = False
    jump kitchen

label cook:
    $ renpy.free_memory()
    $ hide_all_ui()
    scene bg cook
    show screen table
    show screen back_arrow_to_kitchen
    show screen skovorodka
    show screen list1
    show screen meat
    show screen onion
    show screen carrot
    show screen ketchup
    show screen pasta
    show screen oil
    show screen muka
    show screen miska
    show screen forma
    show screen terka
    show screen salt
    show screen paper
    show screen milk
    show screen nuts
    show screen knife
    show screen doska
    show screen cheese
    show screen duhovka
    call screen wait_for_click
    return

