            focus_mask True
            action Jump("dice")  # Показываем меню выбора

label kosti:
    $ renpy.free_memory()
    scene bg kosti
    $ hide_all_ui()
    show screen money
    show screen inventory_bag
    show screen back_arrow_to_casino_hall
    show screen odd
    show screen even
    show screen odintri
    show screen chetireshest
    show screen odin2
    show screen tri4
    show screen pyat6
    show screen odyn
    show screen dva
    show screen tri
    show screen chetire
    show screen pyat
    show screen shest
    if resoult_kosti == 6:
        show screen kost6
    elif resoult_kosti == 5:
        show screen kost5
    elif resoult_kosti == 4:
        show screen kost4
    elif resoult_kosti == 3:
        show screen kost3
    elif resoult_kosti == 2:
        show screen kost2
    elif resoult_kosti == 1:
        show screen kost1
    call screen wait_for_click

    return

screen money:
    text "Деньги: [money]₽"

