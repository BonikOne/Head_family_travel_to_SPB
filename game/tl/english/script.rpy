# game/script.rpy:15739
translate english barmen_dialog_73761b8c:

    # voice "audio/voices/barmen/6.mp3"
    # barmen "Оно было последнее, стакан можешь взять, а вот с пивом извини, было последнее."
    voice "audio/voices/barmen/6_en.mp3"
    barmen "It was the last one, you can take a glass, but sorry about the beer, it was the last one."

# game/script.rpy:15741
