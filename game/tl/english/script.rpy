    # voice "audio/voices/barmen/1.mp3"
    # barmen "Здравствуйте, да, что вы хотели?"
    voice "audio/voices/barmen/1_en.mp3"
    barmen "Hello, yes, what did you want?"

# game/script.rpy:15722
translate english barmen_dialog_c5ae55f8:

    # voice "audio/voices/vika/418.mp3"
    # Vika "Да так, ничего, просто вчера тут весь день никого не было"
    voice "audio/voices/vika/418_en.mp3"
    Vika "Well, nothing much, just nobody was here yesterday."

# game/script.rpy:15724
translate english barmen_dialog_2423d315:

    # voice "audio/voices/barmen/2.mp3"
    # barmen "Я часто отлучаюсь по просьбе начальства на склад... ну или еще куда-нибудь. Чем я могу вам помочь?"
    voice "audio/voices/barmen/2_en.mp3"
    barmen "I often go out on the request of management to the warehouse... or somewhere else. How can I help you?"

# game/script.rpy:15729
translate english barmen_dialog_d83bd328:

    # voice "audio/voices/barmen/3.mp3"
    # barmen "Я вернулся, ну как ты тут справилась?"
    voice "audio/voices/barmen/3_en.mp3"
    barmen "I'm back, so how did you manage here?"

# game/script.rpy:15733
translate english barmen_dialog_ec6d32f9:

    # voice "audio/voices/barmen/4.mp3"
    # barmen "Молодец! Можешь взять стакан."
    voice "audio/voices/barmen/4_en.mp3"
    barmen "Good job! You can take a glass."

# game/script.rpy:15735
translate english barmen_dialog_06caf652:

    # voice "audio/voices/barmen/5.mp3"
    # barmen "Ты что продала пиво?"
    voice "audio/voices/barmen/5_en.mp3"
